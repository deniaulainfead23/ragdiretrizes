<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.6-c145 79.163499, 2018/08/13-16:40:22        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:Iptc4xmpCore="http://iptc.org/std/Iptc4xmpCore/1.0/xmlns/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
   Iptc4xmpCore:CountryCode="KEN"
   photoshop:Credit="Â© UNHCR/Sebastian Rich">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Sebastian Rich</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Refugee students attending the Angelina Jolie Primary School in Kakuma camp learn computer coding. The programme is supported by the iamtheCODE movement that aims to train 1 million women and girls by 2030. ; Kakuma refugee camp, and neighbouring Kalobeyei settlement are located in north-west Kenya. Kakuma was established in 1992 to accommodate Sudanese refugees. That year it also received Ethiopian refugees fleeing political turmoil and Somalians fleeing insecurity and civil strife. Kalobeyei was established in 2014 when Kakuma surpassed its capacity. Across the sites that make up the two settlements, the population of registered refugees and asylum-seekers is around 190,000.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <xmpRights:UsageTerms>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">This image, video, audio or multimedia is copyrighted and may only be reproduced with permission from authorised staff at UNHCR. Images, video, audio and multimedia may only be used under licence for editorial use relating to UNHCR-supported issues and only where the content of the media is accurately represented and captioned. Use in a commercial or promotional context or for fundraising is not allowed without UNHCRâ€™s consent. A credit is always required in the format 'Â© UNHCR/Photographer' for photo images and 'Â© UNHCR' for video, audio and multimedia unless stated otherwise.</rdf:li>
    </rdf:Alt>
   </xmpRights:UsageTerms>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

endstream
